{
  "manifest_version": 3,
  "name": "Reelcards",
  "version": "0.3.0",
  "description": "Your flashcards, slipped in between the short videos you watch on TikTok, Instagram Reels, YouTube Shorts and X.",
  "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png", "256": "icons/icon-256.png", "512": "icons/icon-512.png"},
  "action": {"default_popup": "popup.html", "default_title": "Reelcards", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}},
  "background": {"service_worker": "background.js"},
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["https://www.tiktok.com/*", "https://m.tiktok.com/*", "https://www.instagram.com/*", "https://www.youtube.com/*", "https://m.youtube.com/*", "https://x.com/*", "https://twitter.com/*"],
  "content_scripts": [{
    "matches": ["https://www.tiktok.com/*", "https://m.tiktok.com/*", "https://www.instagram.com/*", "https://www.youtube.com/*", "https://m.youtube.com/*", "https://x.com/*", "https://twitter.com/*"],
    "js": ["lib/engine.js", "lib/render.js", "lib/card-css.js", "state.js", "content.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["fonts/*.ttf"],
    "matches": ["https://www.tiktok.com/*", "https://m.tiktok.com/*", "https://www.instagram.com/*", "https://www.youtube.com/*", "https://m.youtube.com/*", "https://x.com/*", "https://twitter.com/*"]
  }]
}
