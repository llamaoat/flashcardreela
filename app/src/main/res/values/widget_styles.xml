<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WidgetButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:background">@drawable/widget_button</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">normal</item>
    </style>
    <style name="WidgetButton.Main">
        <item name="android:background">@drawable/widget_button_main</item>
        <item name="android:textColor">@color/widget_on_ink</item>
    </style>
</resources>
