<?xml version="1.0" encoding="utf-8"?>
<!-- The home-screen widget (CardWidget.java). Widgets can only be drawn from layout XML (RemoteViews),
     the one place the app uses it; every other screen is built in code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/deck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="#FF9C9CA9"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/question"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="4"
        android:textColor="#FFECEBE6"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/answer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="#FFFFE14D"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView android:id="@+id/reveal" style="@style/WidgetButton.Main" android:text="@string/widget_reveal" />
        <TextView android:id="@+id/knew" style="@style/WidgetButton.Main" android:text="@string/widget_knew" android:visibility="gone" />
        <TextView android:id="@+id/again" style="@style/WidgetButton" android:text="@string/widget_again" android:visibility="gone" />
        <TextView android:id="@+id/open" style="@style/WidgetButton" android:text="@string/widget_open" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
